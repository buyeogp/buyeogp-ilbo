{
  "name": "buyeogp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "부여GP 돈사 일보 시스템 API — 검증 룰 · 권한 · 일보 PDF 생성 · SSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "migrate:reset": "node src/db/migrate.js --reset",
    "verify": "node src/db/verify.js",
    "load:m3": "node src/db/load-m3.js",
    "setup:role": "node src/db/setup-app-role.js",
    "pdf": "node src/pdf/render.js",
    "pdf:all": "node src/pdf/render-all.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:users": "node src/db/seed-users.js",
    "smoke": "node src/http/smoke.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "puppeteer-core": "^24.10.0"
  }
}
