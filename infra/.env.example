# =====================================================================
# 부여GP 일보 시스템 — 환경 변수 견본
#   cp .env.example .env  후 값을 채운다. .env 는 저장소에 넣지 않는다.
# =====================================================================

# ── 데이터베이스 (Supabase 서울 / ap-northeast-2) ─────────────────────
# Supabase 대시보드 > Project Settings > Database > Connection string
# 반드시 "Direct connection"(5432)을 쓴다. 풀러(6543)는 필요 없다 —
# 동시 접속이 7명 수준이고, 직접 연결이어야 buyeogp_app 역할 분리가 유지된다.
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# 운영 접속 계정 — buyeogp_app 그룹에 소속시킨 로그인 역할
# (생성 절차는 README.md 「3. 접속 계정 만들기」)
DB_USER=buyeogp_api
DB_PASSWORD=

# 마이그레이션·유지보수용 (Supabase 의 postgres 계정)
# 평상시 .env 에 두지 말고 실행할 때만 주입하는 편이 낫다
DB_MIGRATE_USER=postgres
DB_MIGRATE_PASSWORD=

# ── 파일 저장 (Supabase Storage) ──────────────────────────────────────
# 폐사 사진(V10 필수) · 거래명세표 스캔 · 일보 PDF 보관
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_MORTALITY=mortality-photo
STORAGE_BUCKET_INVOICE=medicine-invoice
STORAGE_BUCKET_REPORT=daily-report-pdf

# ── 애플리케이션 ─────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=3000
APP_BASE_URL=https://ilbo.example.co.kr
SESSION_SECRET=

# §6.7 세션 만료 — 현장 15분 / 본사 30분
SESSION_TIMEOUT_FIELD_MIN=15
SESSION_TIMEOUT_HQ_MIN=30

# §6.4 마감 — 18:00 미제출 알림, 18:30 마감
REPORT_CLOSE_TIME=18:30
REPORT_REMIND_TIME=18:00
TZ=Asia/Seoul

# ── 알림 (D 항목) ────────────────────────────────────────────────────
# 1단계 : 웹 푸시. VAPID 키는 `npx web-push generate-vapid-keys` 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.co.kr

# 보조 : NCP Outbound Mailer
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
MAIL_FROM=noreply@example.co.kr

# 2단계 : 카카오 알림톡 (발신프로필·템플릿 심사 후)
# KAKAO_SENDER_KEY=
# KAKAO_TEMPLATE_UNSUBMITTED=

# ── 관측 ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── 백업 (§6.6 보존 3년) ─────────────────────────────────────────────
# Supabase Pro 의 자동 백업·PITR 은 보존 7일이다. HACCP 3년 요건을 덮지 못하므로
# 야간 논리 백업을 별도 보관한다. README.md 「6. 백업」 참조.
BACKUP_DIR=/var/backups/buyeogp
BACKUP_RETENTION_DAYS=1100
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── 로컬 검증용 (docker compose --profile localdb) ────────────────────
LOCAL_DB_PASSWORD=localdev
